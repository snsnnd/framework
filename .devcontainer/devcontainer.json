{
  "name": "EFW Qt/VNC Codespace",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "vscode",
  "containerEnv": {
    "DISPLAY": ":1",
    "QT_QPA_PLATFORM": "xcb",
    "VNC_GEOMETRY": "1920x1260",
    "VNC_DEPTH": "24",
    "VNC_PASSWORD": "123456",
    "VNC_PORT": "5901",
    "NOVNC_PORT": "6080",
    "VNC_SESSION": "xterm"
  },
  "forwardPorts": [
    6080,
    5901
  ],
  "portsAttributes": {
    "6080": {
      "label": "noVNC desktop for PyQt tools",
      "onAutoForward": "silent"
    },
    "5901": {
      "label": "Raw VNC desktop",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/start-vnc.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cmake-tools",
        "ms-vscode.cpptools",
        "ms-python.python"
      ],
      "settings": {
        "cmake.configureOnOpen": false,
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
