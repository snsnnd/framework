{
  "name": "Qt VNC Codespaces",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "forwardPorts": [6080, 5901],
  "portsAttributes": {
    "6080": {
      "label": "noVNC Desktop",
      "onAutoForward": "openBrowser"
    },
    "5901": {
      "label": "VNC Server",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "chmod +x .devcontainer/start-vnc.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools"
      ]
    }
  }
}
