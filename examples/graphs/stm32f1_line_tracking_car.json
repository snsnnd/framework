  "custom_files": [
    {
      "path": "app_custom.c",
      "content": "/**\n * @file    app_custom.c\n * @brief   STM32F1 循迹车用户代码\n *\n * 本文件包含所有用户自定义的回调函数实现。\n * 生成的代码框架会自动调用这些函数。\n */\n\n#include \"efw/efw.h\"\n#include \"app_board_config.h\"\n\n/* ========================================================================\n *  超声波传感器\n * ======================================================================== */\n\nstatic float g_distance_cm = 0.0f;\n\nefw_status_t app_ultrasonic_read(void *ctx, void *out, uint16_t out_size) {\n    (void)ctx;\n    if (!out) return EFW_ERR_INVALID;\n    \n    /* TODO: 实现超声波测距\n     * 1. 发送10us TRIG脉冲\n     * 2. 测量ECHO高电平时间\n     * 3. 计算距离: distance = time_us / 58.0f\n     */\n    *(float *)out = g_distance_cm;\n    return EFW_OK;\n}\n\n/* ========================================================================\n *  电池电压\n * ======================================================================== */\n\nstatic float g_battery_voltage = 7.4f;\n\nefw_status_t app_battery_read(void *ctx, void *out, uint16_t out_size) {\n    (void)ctx;\n    if (!out) return EFW_ERR_INVALID;\n    \n    /* TODO: 实现ADC采集\n     * 1. 读取ADC通道\n     * 2. 转换为电压值\n     */\n    *(float *)out = g_battery_voltage;\n    return EFW_OK;\n}\n\n/* ========================================================================\n *  状态LED\n * ======================================================================== */\n\nefw_status_t app_status_led_write(void *ctx, const void *cmd, uint16_t cmd_size) {\n    (void)ctx;\n    const efw_actuator_cmd_t *led_cmd = (const efw_actuator_cmd_t *)cmd;\n    if (!led_cmd) return EFW_ERR_INVALID;\n    \n    /* TODO: 实现LED控制\n     * led_cmd->value > 0.5f -> LED ON\n     * led_cmd->value <= 0.5f -> LED OFF\n     */\n    return EFW_OK;\n}\n\n/* ========================================================================\n *  状态机回调\n * ======================================================================== */\n\nefw_status_t app_state_idle_enter(void *ctx) {\n    (void)ctx;\n    /* 停止电机 */\n    efw_motor_set_diff(\"left_motor\", \"right_motor\", 0.0f, 0.0f);\n    return EFW_OK;\n}\n\nefw_status_t app_state_idle_update(void *ctx) {\n    (void)ctx;\n    return EFW_OK;\n}\n\nefw_status_t app_state_tracking_enter(void *ctx) {\n    (void)ctx;\n    /* 启动循迹 */\n    return EFW_OK;\n}\n\nefw_status_t app_state_tracking_update(void *ctx) {\n    (void)ctx;\n    /* 循迹逻辑在line_follower flow中自动执行 */\n    return EFW_OK;\n}\n\nefw_status_t app_state_avoiding_enter(void *ctx) {\n    (void)ctx;\n    /* 后退并转向 */\n    efw_motor_set_diff(\"left_motor\", \"right_motor\", -30.0f, 30.0f);\n    return EFW_OK;\n}\n\nefw_status_t app_state_avoiding_update(void *ctx) {\n    (void)ctx;\n    return EFW_OK;\n}\n\nefw_status_t app_state_stopped_enter(void *ctx) {\n    (void)ctx;\n    /* 紧急停止 */\n    efw_motor_stop(\"left_motor\");\n    efw_motor_stop(\"right_motor\");\n    return EFW_OK;\n}\n\n/* ========================================================================\n *  状态机条件函数\n * ======================================================================== */\n\nint app_can_start_tracking(void) {\n    /* 检测到黑线时开始循迹 */\n    float value = 0.0f;\n    efw_sensor_read(\"line_sensor\", &value, sizeof(value));\n    return value > 0.0f;\n}\n\nint app_detect_obstacle(void) {\n    /* 距离小于20cm时检测到障碍物 */\n    return g_distance_cm < 20.0f && g_distance_cm > 0.0f;\n}\n\nint app_obstacle_cleared(void) {\n    /* 距离大于30cm时障碍物已清除 */\n    return g_distance_cm > 30.0f || g_distance_cm <= 0.0f;\n}\n\nint app_battery_low(void) {\n    /* 电压低于6.5V时电池低电量 */\n    return g_battery_voltage < 6.5f;\n}\n\n/* ========================================================================\n *  事件回调\n * ======================================================================== */\n\nvoid app_on_battery_update(uint16_t topic_id, const void *data, uint16_t size, void *user) {\n    (void)topic_id;\n    (void)size;\n    (void)user;\n    if (data) {\n        g_battery_voltage = *(const float *)data;\n    }\n}\n\n/* ========================================================================\n *  周期任务\n * ======================================================================== */\n\nefw_status_t app_battery_sample_100ms(void) {\n    /* 定期采样电池电压 */\n    efw_sensor_read(\"battery_sensor\", &g_battery_voltage, sizeof(g_battery_voltage));\n    return EFW_OK;\n}\n\nefw_status_t app_status_report_500ms(void) {\n    /* 定期报告状态 */\n    /* TODO: 通过UART发送状态信息 */\n    return EFW_OK;\n}\n\n/* ========================================================================\n *  10ms控制循环\n * ======================================================================== */\n\nefw_status_t app_control_loop_10ms(void) {\n    /* 读取超声波距离 */\n    efw_sensor_read(\"ultrasonic\", &g_distance_cm, sizeof(g_distance_cm));\n    return EFW_OK;\n}\n\n/* ========================================================================\n *  100ms状态更新任务\n * ======================================================================== */\n\nefw_status_t app_status_update_100ms(void) {\n    /* TODO: 实现状态更新逻辑 */\n    return EFW_OK;\n}\n\n/* ========================================================================\n *  距离处理器\n * ======================================================================== */\n\nefw_status_t app_process_distance(void *ctx, const efw_app_multi_input_t *in, void *out) {\n    (void)ctx;\n    if (!in || !out) return EFW_ERR_INVALID;\n    \n    float distance = *(const float *)in;\n    float *led_value = (float *)out;\n    \n    /* 距离越近，LED越亮 */\n    if (distance < 10.0f) {\n        *led_value = 1.0f;  /* 很近，全亮 */\n    } else if (distance < 30.0f) {\n        *led_value = 0.5f;  /* 较近，半亮 */\n    } else {\n        *led_value = 0.0f;  /* 较远，灭 */\n    }\n    \n    return EFW_OK;\n}\n"
    },
    {
      "path": "board_adapters/stm32f1_hal.c",
      "content": "/**\n * @file    stm32f1_hal.c\n * @brief   STM32F1 HAL适配层\n *\n * 本文件包含STM32F1特定的硬件操作实现。\n * 用户需要根据实际硬件连接修改以下函数。\n */\n\n#include \"efw/efw.h\"\n#include \"app_board_config.h\"\n\n/* STM32 HAL头文件 */\n/* #include \"stm32f1xx_hal.h\" */\n\n/* ========================================================================\n *  GPIO操作\n * ======================================================================== */\n\n/*\n * 根据APP_PINPLAN_xxx宏定义实现GPIO读写\n * \n * 示例:\n * HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_0)\n * HAL_GPIO_WritePin(GPIOB, GPIO_PIN_0, GPIO_PIN_SET)\n */\n\n/* ========================================================================\n *  PWM操作\n * ======================================================================== */\n\n/*\n * 根据APP_PINPLAN_xxx_PWM宏定义实现PWM输出\n *\n * 示例:\n * __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, duty_cycle)\n */\n\n/* ========================================================================\n *  ADC操作\n * ======================================================================== */\n\n/*\n * 实现ADC采集用于电池电压检测\n *\n * 示例:\n * HAL_ADC_Start(&hadc1);\n * HAL_ADC_PollForConversion(&hadc1, 100);\n * uint32_t adc_value = HAL_ADC_GetValue(&hadc1);\n */\n\n/* ========================================================================\n *  超声波操作\n * ======================================================================== */\n\n/*\n * 实现HC-SR04超声波测距\n *\n * 1. TRIG引脚输出10us高电平\n * 2. 测量ECHO引脚高电平持续时间\n * 3. 计算距离: distance_cm = time_us / 58.0f\n */\n"
    }
  ],
